extends SceneTree
## Writes addons/nconsole/games/raycast_tables.asm, the tables and tiles of
## the raycaster (games/raycast.asm). The N8 has no multiply and the
## assembler no trigonometry, so whatever needs either is worked out here:
##
##   godot --headless --path . -s tools/make_raycast_tables.gd
##
## Angles are 0-255 for a full turn, 0 toward +x (east), growing toward +y
## (south, down the map). Positions and distances are 8.8 fixed point, in
## map cells.

const OUT := "res://addons/nconsole/games/raycast_tables.asm"
const FONT_FROM := "res://addons/nconsole/games/hopper.asm"

## Pixels from the eye to the screen: 40 rays one angle step (1.4 degrees)
## apart are 56 degrees, across 160 pixels.
const PROJECTION := 160.0
## Half the view's height, in pixels: the most a wall reaches from the horizon.
const HALF_VIEW := 48
## The colors: ceiling, floor, and the two sides of the walls.
const CEILING := "3"
const FLOOR := "2"
const WALL := ["e", "d"]

var out := PackedStringArray()


func _initialize() -> void:
	out.append("; Generated by tools/make_raycast_tables.gd: change that, not this.")
	out.append("")
	_fixed_bank()
	_height_bank()
	_tiles()
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string("\n".join(out) + "\n")
	f.close()
	print("wrote ", OUT)
	quit()


# --- the fixed bank -------------------------------------------------------------

func _fixed_bank() -> void:
	# Quarter squares: a * b = qs(a + b) - qs(|a - b|), qs(n) = n * n / 4.
	var qs := PackedInt32Array()
	for n in 512:
		qs.append(n * n / 4)
	_bytes("qsl0", "quarter squares of 0-255, low bytes", _map(qs.slice(0, 256), func(v: int) -> int: return v & 255))
	_bytes("qsh0", "and high bytes", _map(qs.slice(0, 256), func(v: int) -> int: return v >> 8))
	_bytes("qsl1", "quarter squares of 256-511", _map(qs.slice(256, 512), func(v: int) -> int: return v & 255))
	_bytes("qsh1", "", _map(qs.slice(256, 512), func(v: int) -> int: return v >> 8))

	# How far a ray at angle a goes to cross one cell in x: 1 / |cos a|.
	var dd := PackedInt32Array()
	for a in 256:
		var c := absf(cos(TAU * a / 256.0))
		dd.append(32767 if c < 0.0001 else mini(32767, roundi(256.0 / c)))
	_bytes("ddl", "1 / |cos a|, 8.8 (for y: the angle minus 64)", _map(dd, func(v: int) -> int: return v & 255))
	_bytes("ddh", "", _map(dd, func(v: int) -> int: return v >> 8))

	# A step of the player: 1/16 of a cell along the angle.
	var mv := PackedInt32Array()
	for a in 256:
		mv.append(roundi(16.0 * cos(TAU * a / 256.0)) & 255)
	_bytes("mv", "x of a step at angle a, signed 1/256 cells (for y: minus 64)", mv)

	# Which page of htab each of the 40 rays reads.
	var pages := PackedStringArray()
	for c in 40:
		pages.append(">htab + %d" % absi(c - 20))
	out.append("; the page of htab for each ray: its angle from the middle")
	out.append("hpage:")
	for k in range(0, 40, 10):
		out.append("\t.byte " + ", ".join(pages.slice(k, k + 10)))
	out.append("")

	# The tiles a ray's wall needs, row by row from the horizon. A tile holds
	# two rays side by side; its index is 9 * left + right (above the
	# horizon; FLOOR_TILES more below it), each ray's state 0 for no wall, 1-4
	# for 2-8 pixels of the light side, 5-8 for the dark side. The tables are
	# read with x = 32 * side + hq, hq the wall's half height in 2-pixel steps.
	for j in 6:
		var left := PackedInt32Array()
		var right := PackedInt32Array()
		for side in 2:
			for hq in 32:
				var w := clampi(2 * mini(hq, HALF_VIEW / 2) - 8 * j, 0, 8) / 2
				var s := 0 if w == 0 else w + 4 * side
				left.append(9 * s)
				right.append(s)
		_bytes("wl%d" % j, "row %d from the horizon: the left ray's part of the tile" % j, left)
		_bytes("wr%d" % j, "and the right ray's", right)

	out.append("; the map's rows")
	for half in ["l", "h"]:
		out.append("maprow_%s:" % half)
		for k in range(0, 32, 8):
			var items := PackedStringArray()
			for row in range(k, k + 8):
				items.append("%s(map + %d)" % ["<" if half == "l" else ">", row * 32])
			out.append("\t.byte " + ", ".join(items))
	out.append("")


# --- bank 0: wall heights -----------------------------------------------------

func _height_bank() -> void:
	# htab + 256 * k: for a ray k angle steps off the middle, the half height
	# of a wall (in 2-pixel steps, 0-24) at a distance of i / 16 cells along
	# the ray. The cosine undoes the fisheye.
	out.append(".bank 0")
	out.append(".org $8000")
	out.append("; wall half heights by angle from the middle (page) and distance / 16 (byte)")
	out.append("htab:")
	for k in 21:
		var row := PackedInt32Array()
		var c := cos(TAU * k / 256.0)
		for i in 256:
			var perp := (i + 0.5) / 16.0 * c
			var half := PROJECTION / perp / 2.0
			row.append(clampi(roundi(half / 2.0), 0, HALF_VIEW / 2))
		_bytes("", "", row)
	out.append("")


# --- tiles --------------------------------------------------------------------

func _tiles() -> void:
	out.append(".section chr")
	out.append("; walls: 81 above the horizon, then 81 below")
	for below in [false, true]:
		for left in 9:
			for right in 9:
				out.append(".tile %d" % ((81 if below else 0) + 9 * left + right))
				for y in 8:
					out.append(_half(left, y, below) + _half(right, y, below))
	out.append("")
	out.append("; the font from Gem Hopper, at FONT + its character")
	var lines := FileAccess.get_file_as_string(FONT_FROM).split("\n")
	var k := 0
	while k < lines.size():
		var line := lines[k].strip_edges()
		if line.begins_with(".tile '") and line.length() == 9:
			out.append(".tile FONT + " + line.substr(6, 3))
			for y in 8:
				out.append(lines[k + 1 + y].strip_edges())
			k += 9
		else:
			k += 1


## Four pixels of row y of a tile, for a ray in state s.
func _half(s: int, y: int, below: bool) -> String:
	var w := 0 if s == 0 else 2 * ((s - 1) % 4 + 1)
	var wall := (y < w) if below else (y >= 8 - w)
	if not wall:
		return (FLOOR if below else CEILING).repeat(4)
	return String(WALL[(s - 1) / 4]).repeat(4)


# --- output -------------------------------------------------------------------

func _bytes(label: String, comment: String, values: PackedInt32Array) -> void:
	if not comment.is_empty():
		out.append("; " + comment)
	if not label.is_empty():
		out.append(label + ":")
	for k in range(0, values.size(), 16):
		var items := PackedStringArray()
		for v in values.slice(k, k + 16):
			items.append("$%02x" % v)
		out.append("\t.byte " + ", ".join(items))


func _map(values: PackedInt32Array, f: Callable) -> PackedInt32Array:
	var result := PackedInt32Array()
	for v in values:
		result.append(f.call(v))
	return result
